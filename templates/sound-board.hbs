<div class="token-sounds token-sounds-wrapper" data-tooltip="">
  {{#each sounds}}
  <div class="sound-control sound {{#if ../editable}}editable{{/if}} {{#if playingRepeat}}playing{{/if}}" data-sound-id="{{this.soundId}}" title="{{this.name}}">
    <img {{#if ../editable}}draggable="true"{{/if}} src="{{this.img}}">
    {{#if playingRepeat}}<i class="fa-solid fa-volume fa-beat"></i>{{/if}}
  </div>
  {{/each}}
  {{#if editable}}
  <div class="sound-control add-sound" title="ADD SOUND"><img src="modules/token-sounds/img/plus-circle-solid.svg"></div>
  {{/if}}
</div>
